# Opcional. O site usa o domínio oficial (https://www.markassistencia.com.br,
# definido em src/config/site.ts) em canonical, Open Graph, sitemap.xml e dados
# estruturados. Defina só para gerar uma cópia do site em outro endereço
# (https, sem barra no final).
VITE_SITE_URL=

# Opcional. ID de medição do Google Analytics 4 (formato G-XXXXXXXXXX). Vazio,
# nada é medido. Com o ID, o gtag.js carrega depois da página e a política de
# privacidade passa a descrever o Google Analytics. Na Vercel, defina em
# Settings → Environment Variables e publique de novo.
VITE_GA_ID=
